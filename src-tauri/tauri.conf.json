{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDraw",
  "version": "0.2.0",
  "identifier": "com.localdraw.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1452",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalDraw",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": ["binaries/llama/*"],
    "fileAssociations": [
      {
        "ext": ["tdraw"],
        "name": "Diagrama LocalDraw",
        "description": "Diagrama/desenho do LocalDraw",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
